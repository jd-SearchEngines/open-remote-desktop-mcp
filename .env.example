PORT=8787
MCP_API_TOKEN=replace-with-a-long-random-token

DEVICE_ID=my-mac
DEVICE_TOKEN=replace-with-a-different-long-random-token
GATEWAY_URL=ws://localhost:8787/device

WORKSPACE_ROOT=/tmp/remote-mcp-workspace
ENABLE_SHELL=false
DESKTOP_COMMANDER_COMMAND=npx
DESKTOP_COMMANDER_ARGS=-y,@wonderwhy-er/desktop-commander@latest
CALL_TIMEOUT_MS=30000

# Used by pnpm verify:remote; set this to the public /mcp URL after tunneling.
MCP_ENDPOINT=http://localhost:8787/mcp
