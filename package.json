{
  "name": "open-remote-desktop-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A single-device remote MCP gateway for DesktopCommanderMCP.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -b",
    "gateway": "node --env-file-if-exists=.env --import tsx apps/gateway/src/index.ts",
    "agent": "node --env-file-if-exists=.env --import tsx apps/agent/src/index.ts",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "test:e2e": "tsx scripts/test-e2e.ts",
    "verify:remote": "node --env-file-if-exists=.env --import tsx scripts/verify-remote.ts",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^6.0.0-dev.20251108"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "ws": "^8.18.3"
  }
}
